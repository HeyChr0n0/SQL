CREATE TABLE instituicoes (
    id INT,
    nome TEXT,
    pais TEXT
);

CREATE TABLE cursos (
    id INT,
    instituicao_id INT,
    nome TEXT,
    nivel TEXT
);

CREATE TABLE disciplinas (
    id INT,
    curso_id INT,
    nome TEXT,
    periodo INT,
    carga_horaria INT
);

CREATE TABLE progresso (
    id INT,
    disciplina_id INT,
    status TEXT,
    nota REAL
);

